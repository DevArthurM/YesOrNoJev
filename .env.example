# Your impossibl.com API key (https://impossibl.com). Used by the server for the cost
# benchmark and as the default key when a user chooses "continue with the server key".
IMPOSSIBL_API_KEY=

# Optional overrides
# PORT=3000
# IMPOSSIBL_API_BASE=https://api.impossibl.com
# JEV_MODEL=typesafe-ai/jev
# Set to false to force every user to paste their own key.
# ALLOW_SERVER_KEY=true
# SQLite file for datasets and results (created on first start, kept afterwards).
# Relative paths are resolved from the server folder (apps/server).
# DATABASE_PATH=data/yesornojev.sqlite
